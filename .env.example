# Optional hosted mode. Set these in the server environment; this file is not auto-loaded.
# GAME_MODEL_CONFIG=data/models.json
# OPENROUTER_API_KEY=
# Or use a separate private file (takes precedence over OPENROUTER_API_KEY):
# OPENROUTER_API_KEY_FILE=data/openrouter.key
# Defaults stay local/scripted when GAME_MODEL_CONFIG is unset.
# Optional PostgreSQL (required when publishing to Replit):
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Use separate development and production databases, with direct/session connections.
